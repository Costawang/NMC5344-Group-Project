# Figure A: Global Distribution of Persons of Concern
# Three-panel visualization, 2020-2025

# 1. Load packages
library(tidyverse)
library(patchwork)
library(scales)

# 2. Import data
df <- read_csv(
  "persons_of_concern_demographics.csv",
  show_col_types = FALSE
)

# 3. Aggregate country-level populations by year
country_year <- df %>%
  group_by(Year, `Country of Asylum`) %>%
  summarise(
    Total_POC = sum(Total, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  filter(Total_POC > 0)

# 4. Colors
main_color <- "#456477"
fill_color <- "#A9C4D6"

# 5. Common theme
base_theme <- theme_minimal(base_size = 11) +
  theme(
    plot.title = element_text(
      face = "bold",
      size = 12
    ),
    plot.subtitle = element_text(
      size = 9,
      color = "grey40"
    ),
    axis.title.x = element_text(
      size = 9,
      margin = margin(t = 8)
    ),
    axis.title.y = element_text(
      size = 9,
      margin = margin(r = 8)
    ),
    axis.text = element_text(size = 8.5),
    panel.grid.major.x = element_blank(),
    panel.grid.major.y = element_line(
      color = "grey83",
      linewidth = 0.35
    ),
    panel.grid.minor.x = element_blank(),
    panel.grid.minor.y = element_line(
      color = "grey91",
      linewidth = 0.25
    ),
    plot.margin = margin(12, 12, 12, 12)
  )

# 6. Reusable boxplot function
make_boxplot <- function() {
  ggplot(
    country_year,
    aes(
      x = factor(Year),
      y = Total_POC
    )
  ) +
    geom_boxplot(
      width = 0.55,
      fill = fill_color,
      color = main_color,
      linewidth = 0.55,
      outlier.alpha = 0.22,
      outlier.size = 0.9
    ) +
    stat_summary(
      aes(group = 1),
      fun = median,
      geom = "line",
      linetype = "dashed",
      color = main_color,
      linewidth = 0.7
    ) +
    stat_summary(
      fun = median,
      geom = "point",
      color = main_color,
      size = 2
    ) +
    labs(
      x = "Year",
      y = "Persons of Concern (log scale)"
    ) +
    base_theme
}

# ============================================================
# A1: Full Distribution
# ============================================================

p1 <- make_boxplot() +
  scale_y_log10(
    breaks = 10^seq(0, 9),
    labels = label_number(
      scale_cut = cut_short_scale()
    )
  ) +
  labs(
    title = "A1 | Full Distribution",
    subtitle = "Including extreme values"
  )

# ============================================================
# A2: Central Distribution (1K-1M)
# ============================================================

p2 <- make_boxplot() +
  scale_y_log10(
    breaks = c(
      1000, 2000, 5000,
      10000, 20000, 50000,
      100000, 200000, 500000,
      1000000
    ),
    labels = c(
      "1K", "2K", "5K",
      "10K", "20K", "50K",
      "100K", "200K", "500K",
      "1M"
    ),
    minor_breaks = as.vector(
      outer(
        1:9,
        10^(3:5),
        "*"
      )
    )
  ) +
  coord_cartesian(
    ylim = c(1000, 1000000),
    expand = FALSE
  ) +
  labs(
    title = "A2 | Central Distribution",
    subtitle = "Magnified view: 1K-1M"
  )

# ============================================================
# A3: Extreme Values - Top 3 Annual Rankings
# ============================================================

top3_yearly <- country_year %>%
  group_by(Year) %>%
  arrange(
    desc(Total_POC),
    .by_group = TRUE
  ) %>%
  slice_head(n = 3) %>%
  mutate(
    Rank = factor(
      row_number(),
      levels = 1:3,
      labels = c("1st", "2nd", "3rd")
    )
  ) %>%
  ungroup()

p3 <- ggplot(
  top3_yearly,
  aes(
    x = Year,
    y = Total_POC,
    group = Rank,
    color = Rank,
    linetype = Rank
  )
) +
  geom_line(
    linewidth = 1
  ) +
  geom_point(
    size = 1.8
  ) +
  scale_color_manual(
    values = c(
      "1st" = "#456477",
      "2nd" = "#8EAABD",
      "3rd" = "#A9C4D6"
    )
  ) +
  scale_linetype_manual(
    values = c(
      "1st" = "solid",
      "2nd" = "dashed",
      "3rd" = "dotted"
    )
  ) +
  scale_x_continuous(
    breaks = 2020:2025
  ) +
  scale_y_continuous(
    limits = c(0, NA),
    breaks = seq(
      0, 30000000, 5000000
    ),
    minor_breaks = seq(
      0, 30000000, 2500000
    ),
    labels = label_number(
      scale = 1e-6,
      suffix = "M"
    ),
    expand = expansion(
      mult = c(0, 0.05)
    )
  ) +
  labs(
    title = "A3 | Extreme Values",
    subtitle = "Top three country totals each year",
    x = "Year",
    y = "Persons of Concern",
    color = "Annual Rank",
    linetype = "Annual Rank"
  ) +
  base_theme +
  theme(
    legend.position = "bottom",
    legend.title = element_text(size = 8),
    legend.text = element_text(size = 8),
    legend.key.width = unit(0.8, "cm")
  )

# ============================================================
# Combine Three Panels
# ============================================================

figure_A <- (p1 | p2 | p3) +
  plot_layout(
    widths = c(1.1, 1, 1)
  ) +
  plot_annotation(
    title = paste(
      "Global Distribution of Persons",
      "of Concern, 2020-2025"
    ),
    subtitle = paste(
      "Overall distribution, central patterns,",
      "and extreme high values"
    ),
    caption = paste(
      "Source: Provided demographics dataset.",
      "Country-level totals aggregated annually.",
      "A1-A2: logarithmic scales;",
      "A3: annual top-three country totals."
    ),
    theme = theme(
      plot.title = element_text(
        face = "bold",
        size = 17,
        margin = margin(b = 7)
      ),
      plot.subtitle = element_text(
        size = 10,
        color = "grey40",
        margin = margin(b = 12)
      ),
      plot.caption = element_text(
        size = 8,
        color = "grey45",
        hjust = 0,
        margin = margin(t = 12)
      ),
      plot.background = element_rect(
        fill = "white",
        color = NA
      ),
      plot.margin = margin(
        18, 20, 15, 20
      )
    )
  )

# ============================================================
# Display and Export
# ============================================================

print(figure_A)

ggsave(
  filename = "Figure_A_Three_Panels.png",
  plot = figure_A,
  width = 16,
  height = 6,
  dpi = 300,
  bg = "white"
)
