## Global Distribution of Persons of Concern (2020–2025)

```{r figure-a, fig.width=16, fig.height=6, out.width='100%', fig.cap='Figure A. Annual distribution, central range, and largest country-level populations of persons of concern, 2020–2025.'}
df <- read_csv("persons_of_concern_demographics.csv", show_col_types = FALSE)

country_year <- df %>%
  group_by(Year, `Country of Asylum`) %>%
  summarise(Total_POC = sum(Total, na.rm = TRUE), .groups = "drop") %>%
  filter(Total_POC > 0)

main_color <- "#456477"
fill_color <- "#A9C4D6"

base_theme <- theme_minimal(base_size = 11) +
  theme(
    plot.title = element_text(face = "bold", size = 12),
    plot.subtitle = element_text(size = 9, color = "grey40"),
    axis.title.x = element_text(size = 9, margin = margin(t = 8)),
    axis.title.y = element_text(size = 9, margin = margin(r = 8)),
    axis.text = element_text(size = 8.5),
    panel.grid.major.x = element_blank(),
    panel.grid.major.y = element_line(color = "grey83", linewidth = 0.35),
    panel.grid.minor.y = element_line(color = "grey91", linewidth = 0.25),
    panel.grid.minor.x = element_blank(),
    plot.margin = margin(12, 12, 12, 12)
  )

make_boxplot <- function() {
  ggplot(country_year, aes(x = factor(Year), y = Total_POC)) +
    geom_boxplot(width = 0.55, fill = fill_color, color = main_color,
                 linewidth = 0.55, outlier.alpha = 0.22, outlier.size = 0.9) +
    stat_summary(aes(group = 1), fun = median, geom = "line",
                 linetype = "dashed", color = main_color, linewidth = 0.7) +
    stat_summary(fun = median, geom = "point", color = main_color, size = 2) +
    labs(x = "Year", y = "Persons of Concern (log scale)") +
    base_theme
}

# A1: complete distribution
p1 <- make_boxplot() +
  scale_y_log10(breaks = 10^(0:9),
                labels = label_number(scale_cut = cut_short_scale())) +
  labs(title = "A1 | Full Distribution", subtitle = "Including extreme values")

# A2: zoomed central range, with more labeled ticks
p2 <- make_boxplot() +
  scale_y_log10(
    breaks = c(1000, 2000, 5000, 10000, 20000, 50000,
               100000, 200000, 500000, 1000000),
    labels = c("1K", "2K", "5K", "10K", "20K", "50K",
               "100K", "200K", "500K", "1M"),
    minor_breaks = as.vector(outer(1:9, 10^(3:5), "*"))
  ) +
  coord_cartesian(ylim = c(1000, 1000000), expand = FALSE) +
  labs(title = "A2 | Central Distribution",
       subtitle = "Magnified view: 1K–1M")

# A3: top three annual country-level totals (rank, not fixed countries)
top3_yearly <- country_year %>%
  group_by(Year) %>%
  arrange(desc(Total_POC), .by_group = TRUE) %>%
  slice_head(n = 3) %>%
  mutate(Rank = factor(row_number(), levels = 1:3,
                       labels = c("1st", "2nd", "3rd"))) %>%
  ungroup()

p3 <- ggplot(top3_yearly,
             aes(x = Year, y = Total_POC, group = Rank,
                 color = Rank, linetype = Rank)) +
  geom_line(linewidth = 1) +
  geom_point(size = 1.8) +
  scale_color_manual(values = c("1st" = "#456477",
                                "2nd" = "#8EAABD",
                                "3rd" = "#A9C4D6")) +
  scale_linetype_manual(values = c("1st" = "solid",
                                   "2nd" = "dashed",
                                   "3rd" = "dotted")) +
  scale_x_continuous(breaks = 2020:2025) +
  scale_y_continuous(
    limits = c(0, NA),
    breaks = seq(0, 30000000, 5000000),
    minor_breaks = seq(0, 30000000, 2500000),
    labels = label_number(scale = 1e-6, suffix = "M"),
    expand = expansion(mult = c(0, 0.05))
  ) +
  labs(title = "A3 | Extreme Values",
       subtitle = "Top three country totals each year",
       x = "Year", y = "Persons of Concern",
       color = "Annual Rank", linetype = "Annual Rank") +
  base_theme +
  theme(legend.position = "bottom",
        legend.title = element_text(size = 8),
        legend.text = element_text(size = 8),
        legend.key.width = grid::unit(0.8, "cm"))

figure_A <- (p1 | p2 | p3) +
  plot_layout(widths = c(1.1, 1, 1)) +
  plot_annotation(
    title = "Global Distribution of Persons of Concern, 2020–2025",
    subtitle = "Overall distribution, central patterns, and extreme high values",
    caption = paste(
      "Source: Provided demographics dataset. Country-level totals aggregated annually.",
      "A1–A2: logarithmic scales; A3: annual top-three country totals."
    ),
    theme = theme(
      plot.title = element_text(face = "bold", size = 17,
                                margin = margin(b = 7)),
      plot.subtitle = element_text(size = 10, color = "grey40",
                                   margin = margin(b = 12)),
      plot.caption = element_text(size = 8, color = "grey45",
                                  hjust = 0, margin = margin(t = 12)),
      plot.background = element_rect(fill = "white", color = NA),
      plot.margin = margin(18, 20, 15, 20)
    )
  )

print(figure_A)
```

Figure A illustrates the distribution of persons of concern across countries of asylum from 2020 to 2025. Country-level totals were aggregated annually, and three panels were used to capture different aspects of the highly skewed distribution.

Panel A1 presents the overall distribution on a logarithmic scale, revealing substantial disparities across countries and consistently high outliers. Panel A2 magnifies the central distribution (1,000–1 million), showing an upward shift in median population figures, particularly after 2021. The median increased from approximately 38,480 in 2020 to 93,032 in 2025. Panel A3 highlights the three largest country-level populations each year, showing that extreme values persisted throughout the study period, with the highest annual figure peaking at approximately 24 million in 2024.

Overall, the findings indicate increasing country-level population figures alongside substantial geographical disparities, providing global context for the subsequent analysis of Palestinian populations.
